diff --git a/train/pilot_monitor.py b/train/pilot_monitor.py
new file mode 100644
index 0000000..5e309d6
--- /dev/null
+++ b/train/pilot_monitor.py
@@ -0,0 +1,121 @@
+"""Rank-zero TensorBoard and CSV monitoring for the removal pilot."""
+
+from __future__ import annotations
+
+import atexit
+import csv
+import json
+import os
+from collections import Counter
+from pathlib import Path
+from typing import Mapping
+
+from torch.utils.tensorboard import SummaryWriter
+
+
+FIELDS = [
+    "step",
+    "total_loss",
+    "mse_loss",
+    "ce_loss",
+    "lr",
+    "grad_norm",
+    "total_samples",
+    "total_mse_tokens",
+    "total_ce_tokens",
+    "max_memory_allocated_mb",
+    "max_memory_reserved_mb",
+    "steps_per_second",
+    "step_wall_time_seconds",
+]
+
+
+class TrainingMonitor:
+    def __init__(self, run_output_dir: str, purge_step: int = 0):
+        self.run_dir = Path(run_output_dir)
+        self.tensorboard_dir = self.run_dir / "tensorboard"
+        self.metrics_path = self.run_dir / "metrics.csv"
+        self.dataset_samples_path = self.run_dir / "dataset_samples.csv"
+        self.summary_path = self.run_dir / "training_summary.json"
+        self.tensorboard_dir.mkdir(parents=True, exist_ok=True)
+        self.writer = SummaryWriter(
+            log_dir=str(self.tensorboard_dir),
+            purge_step=purge_step if purge_step > 0 else None,
+        )
+        exists = self.metrics_path.exists() and self.metrics_path.stat().st_size > 0
+        self.handle = self.metrics_path.open("a", encoding="utf-8", newline="")
+        self.csv_writer = csv.DictWriter(self.handle, fieldnames=FIELDS)
+        if not exists:
+            self.csv_writer.writeheader()
+            self.handle.flush()
+            os.fsync(self.handle.fileno())
+        dataset_exists = (
+            self.dataset_samples_path.exists()
+            and self.dataset_samples_path.stat().st_size > 0
+        )
+        self.dataset_handle = self.dataset_samples_path.open(
+            "a", encoding="utf-8", newline=""
+        )
+        self.dataset_writer = csv.DictWriter(
+            self.dataset_handle, fieldnames=["step", "dataset_name", "samples"]
+        )
+        if not dataset_exists:
+            self.dataset_writer.writeheader()
+            self.dataset_handle.flush()
+            os.fsync(self.dataset_handle.fileno())
+        self.closed = False
+        atexit.register(self.close)
+
+    def log(self, step: int, metrics: Mapping[str, float]) -> None:
+        row = {field: metrics.get(field, 0.0) for field in FIELDS}
+        row["step"] = step
+        self.csv_writer.writerow(row)
+        self.handle.flush()
+        os.fsync(self.handle.fileno())
+        for key, value in row.items():
+            if key != "step":
+                self.writer.add_scalar(f"train/{key}", float(value), step)
+        self.writer.flush()
+
+    def log_datasets(self, step: int, data_indexes) -> None:
+        counts = Counter(item["dataset_name"] for item in data_indexes)
+        for dataset_name, samples in sorted(counts.items()):
+            self.dataset_writer.writerow(
+                {
+                    "step": step,
+                    "dataset_name": dataset_name,
+                    "samples": samples,
+                }
+            )
+            self.writer.add_scalar(
+                f"train_dataset/{dataset_name}", float(samples), step
+            )
+        self.dataset_handle.flush()
+        os.fsync(self.dataset_handle.fileno())
+        self.writer.flush()
+
+    def write_summary(self, completed_steps: int, exception_count: int) -> None:
+        temporary = self.summary_path.with_suffix(".json.part")
+        temporary.write_text(
+            json.dumps(
+                {
+                    "completed_steps": completed_steps,
+                    "exception_count": exception_count,
+                    "metrics_csv": str(self.metrics_path),
+                    "dataset_samples_csv": str(self.dataset_samples_path),
+                    "tensorboard_dir": str(self.tensorboard_dir),
+                },
+                indent=2,
+            )
+            + "\n",
+            encoding="utf-8",
+        )
+        temporary.replace(self.summary_path)
+
+    def close(self) -> None:
+        if self.closed:
+            return
+        self.writer.close()
+        self.handle.close()
+        self.dataset_handle.close()
+        self.closed = True
